# Must match "@playwright/test" in package.json
PLAYWRIGHT_VERSION=1.64.1
# Pin for reproducible builds (npm view @playwright/cli version)
PLAYWRIGHT_CLI_VERSION=latest

# Application under test (required)
BASE_URL=http://host.docker.internal:8000
CI=false

# Throttle every action by <ms> so a human can follow a headed run. 0 = off.
SLOW_MO=0

# Account used by tests/auth.setup.ts to save .auth/user.json (optional)
APP_USER_EMAIL=
APP_USER_PASSWORD=
